#!/bin/sh
# Eho scope guard — opt-in pre-commit hook. Setup (see ONBOARDING.md):
#   git config core.hooksPath .githooks
#   git config eho.scope backend             # or several: "contracts,product"
# Scopes: mobile | backend | organizer-web | contracts | integration | product | all
# Blocks commits whose staged paths fall outside your scope(s).
# Not a security boundary: humans can bypass with --no-verify; agents must never do so.

scopes=$(git config --get eho.scope | tr ',' ' ')
[ -n "$scopes" ] || exit 0

for s in $scopes; do
  case "$s" in
    all|mobile|backend|organizer-web|contracts|integration|product) ;;
    *) echo "eho scope guard: unknown scope '$s' in git config eho.scope" >&2; exit 1 ;;
  esac
done

# allowed <path> <scope> -> exit 0 if <scope> may write <path>
allowed() {
  case "$2" in
    all) return 0 ;;
    mobile|backend|organizer-web)
      case "$1" in "$2"/*|docs/decisions/"$2"-*) return 0 ;; esac ;;
    contracts)
      case "$1" in contracts/*|docs/decisions/contracts-*) return 0 ;; esac ;;
    integration)
      case "$1" in
        docs/decisions/team-*|.github/*|.githooks/*) return 0 ;;
        AGENTS.md|CLAUDE.md|README.md|ONBOARDING.md|.gitignore|.editorconfig) return 0 ;;
        docs/COORDINATION.md|docs/OWNERSHIP.md|docs/INTEGRATION.md|docs/DECISIONS.md) return 0 ;;
      esac ;;
    product)
      case "$1" in
        docs/decisions/product-*) return 0 ;;
        docs/decisions/*|docs/COORDINATION.md|docs/OWNERSHIP.md|docs/INTEGRATION.md|docs/DECISIONS.md) return 1 ;;
        docs/*) return 0 ;;
      esac ;;
  esac
  return 1
}

offending=$(git diff --cached --name-only --no-renames | while IFS= read -r f; do
  ok=1
  for s in $scopes; do
    if allowed "$f" "$s"; then ok=0; break; fi
  done
  [ "$ok" -eq 0 ] || printf '  %s\n' "$f"
done)

if [ -n "$offending" ]; then
  echo "eho scope guard: staged paths outside your scope ($(git config --get eho.scope)):" >&2
  printf '%s\n' "$offending" >&2
  echo "Unstage them with: git restore --staged -- <path>" >&2
  echo "Need a change there? Open a request (docs/COORDINATION.md section 4)." >&2
  exit 1
fi
exit 0

# Baseline editor settings. Modules may add their own .editorconfig
# (closer files override this one) once their stack is chosen.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a Markdown line break.
trim_trailing_whitespace = false

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

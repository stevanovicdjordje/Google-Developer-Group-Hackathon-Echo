# Copy to .env (git-ignored) or export in the shell. Placeholders only.
# scripts/dev.sh sets the emulator variables for local runs.
PORT=8085
EHO_BASE_URL=http://localhost:8085
EHO_COOKIE_SECURE=false
EHO_TIMEZONE=Europe/Belgrade
# Flutter app (attendee app + organizer map editor), for links.
EHO_APP_URL=http://localhost:5050
# Echo service (AI summary + audience questions for paid talk reports).
EHO_ECHO_URL=http://localhost:8082

# Firebase project shared with backend/maps and backend/events.
FIREBASE_PROJECT_ID=demo-eho
# Web API key of the project (needed for email/password sign-in outside the
# emulator; it is a public identifier, not a secret, but keep it in env).
FIREBASE_API_KEY=
# Defaults to <project>.appspot.com, like backend/maps.
STORAGE_BUCKET=

# Local emulators (set by scripts/dev.sh):
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# Optional. Maps Embed API key (restrict it by HTTP referrer). Without it the
# event page shows only the address.
GOOGLE_MAPS_API_KEY=

# Copy to .env (git-ignored) or export in the shell. Placeholders only.
PORT=8080
EHO_DB_PATH=./data/eho.db
EHO_UPLOAD_DIR=./data/uploads
# Set to true when served over HTTPS (Cloud Run): marks cookies Secure.
EHO_COOKIE_SECURE=false
# Public base URL, used to build invitation links.
EHO_BASE_URL=http://localhost:8080
# Time zone for entering and displaying event times (stored as UTC).
EHO_TIMEZONE=Europe/Belgrade
# Optional. Maps Embed API key (restrict it by HTTP referrer). Without it the
# event page shows only the address, no map.
GOOGLE_MAPS_API_KEY=

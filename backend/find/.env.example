# Copy to .env for local runs (never commit .env). Placeholders only.
PORT=8083
FIREBASE_PROJECT_ID=demo-eho
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
LOG_LEVEL=debug
# Gemini API key (https://aistudio.google.com/apikey). Empty = offline overlap ranking (no real AI).
GEMINI_API_KEY=
# docs/decisions/feature-find-ai.md. A gemma-* model also works (thinking then defaults to "minimal").
AI_MODEL=gemini-3-flash-preview
AI_THINKING=low
# Hard limit per call, retries included; then the request gets the offline ranking.
AI_TIMEOUT_SECONDS=8
# Set by scripts/dev.sh when running against the Firebase emulators:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

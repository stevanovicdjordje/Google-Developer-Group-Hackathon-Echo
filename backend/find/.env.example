# Copy to .env for local runs (never commit .env). Placeholders only.
PORT=8083
FIREBASE_PROJECT_ID=demo-eho
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
LOG_LEVEL=debug
# Gemma through the Gemini API (https://aistudio.google.com/apikey). Empty = offline overlap ranking (no real AI).
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemma 4 thinks by default (10+ s per answer); "minimal" turns it off. Empty = model default.
GEMMA_THINKING=minimal
AI_TIMEOUT_SECONDS=20
# Set by scripts/dev.sh when running against the Firebase emulators:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

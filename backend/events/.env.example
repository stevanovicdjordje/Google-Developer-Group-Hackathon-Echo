# Copy to .env for local runs (never commit .env). Placeholders only.
PORT=8084
FIREBASE_PROJECT_ID=demo-eho
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
LOG_LEVEL=debug
# Gemini API key (https://aistudio.google.com/apikey). Empty = drafts only from spreadsheets/CSV (no AI).
GEMINI_API_KEY=
# docs/decisions/feature-events-ai.md
AI_MODEL=gemini-3-flash-preview
AI_THINKING=low
# One extraction, retries included; then 503 ai_unavailable (or the table reader for spreadsheets).
EXTRACT_TIMEOUT_SECONDS=60
# Set by scripts/dev.sh when running against the Firebase emulators:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
